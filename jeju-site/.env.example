# 이 파일을 복사해서 .env 로 만든 뒤 값을 채우세요. (.env 는 GitHub에 올라가지 않습니다)

# Supabase 대시보드 > Project Settings > API 에서 확인
VITE_SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=여기에_anon_public_키(또는_publishable_키)

# https://pixabay.com/api/docs/ (로그인 후) 에서 확인
VITE_PIXABAY_API_KEY=여기에_픽사베이_API_키
